#!/bin/sh
# Slip 的提交前门禁。
#
# 安装（每个克隆一次）：git config core.hooksPath .githooks
# 临时跳过：git commit --no-verify —— CI 仍然会拦住，别养成习惯。
#
# 为什么这些检查放在提交前而不是只放 CI：
# 反复犯过的错误是「只跑了 cargo check，没跑 clippy」，于是两个 lint 错误
# 混进了代码库。门禁必须在最便宜的地方拦。
set -e

# Git Bash 里 cargo 通常不在 PATH（Windows 用户默认也没配）。
if [ -d "$HOME/.cargo/bin" ]; then
  PATH="$HOME/.cargo/bin:$PATH"
fi

BUN="$HOME/.bun/bin/bun"
if [ ! -x "$BUN" ]; then
  BUN="bun"
fi

cd "$(git rev-parse --show-toplevel)"

step() {
  printf '\033[36m[pre-commit]\033[0m %s\n' "$1"
}

# ui/dist 不入库，但外壳**编译期**要读它。缺了就补，否则 clippy 只会给出
# 一句没有指向性的 "proc macro panicked"。
needs_ui_build=0
if [ ! -f ui/dist/index.html ]; then
  needs_ui_build=1
elif [ -n "$(find ui/src ui/index.html ui/package.json ui/vite.config.js ui/vite.config.ts \
    -newer ui/dist/index.html -print -quit 2>/dev/null)" ]; then
  # 源码比产物新：必须重建。
  # 旧实现只在 dist 缺失时构建，于是"改了 src 但 dist 还在"就会拿着**旧产物**跑
  # prettier / 纯逻辑 / 体积三项检查，而 CI 每次都重建——这就是实实在在的门禁漂移。
  needs_ui_build=1
fi
if [ "$needs_ui_build" = "1" ]; then
  step "前端产物缺失或陈旧，先构建"
  ( cd ui && "$BUN" install && "$BUN" run build )
fi

# 编码守卫：*.ps1 必须带 UTF-8 BOM。
#
# 为什么：tools/*.ps1 里有大量中文，而 Windows PowerShell 5.1（以及部分编辑器）
# 在没有 BOM 时按 GBK 解码，中文变乱码并触发语法错。这个坑的排查成本极高——
# 报错位置和真正的原因（文件编码）毫无关系。编辑器和某些工具链会静默剥掉 BOM，
# 所以这里按**暂存区内容**校验，而不是工作区文件。
#
# 放在所有 cargo 步骤之前：几乎不耗时，而且这是唯一能用肉眼之外的证据发现
# "文件编码坏了"的地方。
bom_tmp=$(mktemp)
git diff --cached --name-only --diff-filter=ACM -- '*.ps1' | while IFS= read -r f; do
  [ -n "$f" ] || continue
  first3=$(git show ":$f" 2>/dev/null | head -c 3 | od -An -tx1 | tr -d ' \n')
  if [ "$first3" != "efbbbf" ]; then
    printf '  %s\n' "$f" >> "$bom_tmp"
  fi
done
if [ -s "$bom_tmp" ]; then
  printf '\033[31m[pre-commit]\033[0m 以下 .ps1 缺少 UTF-8 BOM（PowerShell 会按 GBK 解码中文并报语法错）：\n' >&2
  cat "$bom_tmp" >&2
  echo '  修法（PowerShell）：' >&2
  echo '    $p = "<文件>"' >&2
  echo '    $t = [IO.File]::ReadAllText($p, [Text.UTF8Encoding]::new($false))' >&2
  echo '    [IO.File]::WriteAllText($p, $t, [Text.UTF8Encoding]::new($true))' >&2
  echo '  或让编辑器按 .editorconfig 里的 charset=utf-8-bom 保存。' >&2
  rm -f "$bom_tmp"
  exit 1
fi
rm -f "$bom_tmp"
step "编码检查（*.ps1 必须有 BOM）"

# 语法检查：BOM 只管编码，管不了语法。本仓库的验收脚本被频繁手改（引号、
# here-string、中文注释都踩过），语法错却要等到有人在本机跑那条命令才暴露。
# 实现放在 tools/check-ps1-syntax.ps1，CI 用同一份，避免两边逻辑漂移。
if command -v pwsh >/dev/null 2>&1; then
  step "PowerShell 语法检查"
  pwsh -NoProfile -File tools/check-ps1-syntax.ps1
else
  step "PowerShell 语法检查（跳过：环境里没有 pwsh）"
fi

# 「不可回退的约束」里能被文本证据判定的部分。纯 grep，毫秒级。
# 这些条目一旦被破坏代价是架构级返工，而它们原本只靠人记。
if command -v pwsh >/dev/null 2>&1; then
  step "常量：死代码与前后端镜像（tools/check-dead-constants.ps1）"
pwsh -NoProfile -File tools/check-dead-constants.ps1

step "设计文档与代码同步（tools/check-doc-sync.ps1）"
pwsh -NoProfile -File tools/check-doc-sync.ps1

step "钩子与 CI 的门禁对等性（tools/check-ci-parity.ps1）"
pwsh -NoProfile -File tools/check-ci-parity.ps1

step "不可回退的约束（禁止引入清单）"
  # `-SelfTest` 是这份守卫唯一的"守卫本身写错了"探测器：它用临时文件走真实代码路径，
  # 验证 `-Include` 真的能选中 Cargo.toml / tauri.conf.json。从不运行的自检等于没有自检。
  pwsh -NoProfile -File tools/check-forbidden.ps1 -SelfTest
fi

# 前端格式：prettier 3 **不会**自动加载插件，所以 ui/.prettierrc.json 里必须显式
# 声明 prettier-plugin-svelte，否则 *.svelte 会被静默跳过（表现为"检查通过"，
# 其实根本没检查）。这条曾经骗过我一次。
step "prettier --check（ui）"
if [ ! -d ui/node_modules ]; then
  ( cd ui && "$BUN" install )
fi
( cd ui && "$BUN" run format:check )

# 前端纯逻辑（bannerLevel 之类）不依赖浏览器即可验证：毫秒级，先跑。
step "前端纯逻辑检查（tools/check-ui-logic.mjs）"
"$BUN" run tools/check-ui-logic.mjs

# 产物体积门禁（R74）：CSS < 14 KB、JS < 88 KB。超了不会有任何报错，
# 只会让安装包悄悄变大——所以必须在这里硬拦。
step "前端产物体积（tools/check-bundle-size.ps1）"
pwsh -NoProfile -File tools/check-bundle-size.ps1

step "cargo fmt --all --check"
cargo fmt --all --check

step "cargo clippy --workspace --all-targets -D warnings"
cargo clippy --workspace --all-targets --locked -- -D warnings

step "cargo test --workspace"
# 应用控制策略（Smart App Control）会间歇/持久性地阻止执行刚编出来的测试二进制，
# 报 `os error 4551`。那是环境问题不是代码问题，但**不能被当成"测试通过"**：
# 这里显式喊出来并放行，让"本次提交未经完整测试验证"留在输出里。
# 判据严格：只有同时满足"出现 4551"且"没有 test result: FAILED"才放行。
test_log=$(mktemp)
if cargo test --workspace --locked --quiet >"$test_log" 2>&1; then
  cat "$test_log"
elif grep -q "os error 4551" "$test_log" && ! grep -q "test result: FAILED" "$test_log"; then
  cat "$test_log"
  echo ""
  echo "!! [警告] 测试被系统策略阻止执行（os error 4551），本次提交未经完整测试验证。"
  echo "!!        环境恢复后必须补跑：cargo test --workspace"
  echo "!!        详见 AGENTS.md 的「环境陷阱：os error 4551」。"
  echo ""
else
  cat "$test_log"
  rm -f "$test_log"
  exit 1
fi
rm -f "$test_log"

step "通过"
